		"minimatch@9.0.9": "patches/minimatch@9.0.9.patch",
		"minimatch@10.2.4": "patches/minimatch@10.2.4.patch",
		"minimatch@10.2.6": "patches/minimatch@10.2.6.patch",
		"zod@3.25.76": "patches/zod@3.25.76.patch",
		"zod@4.6.7": "patches/zod@4.6.7.patch"
	}
}
