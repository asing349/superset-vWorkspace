		"postcss-selector-parser@^7.0.0": "7.1.7",
		"probe-image-size": "7.5.0",
		"postcss": "8.5.32",
		"node-forge": "1.4.2",
		"proxy-addr": "2.0.8",
		"prosemirror-view": "1.42.8",
		"protobufjs": "7.6.6",
		"qs": "6.17.1",
		"source-map-js": "1.2.2",
		"seroval": "1.7.5",
		"socket.io-parser": "4.2.7",
		"tmp@^0.2.0": "0.2.7",
		"ua-parser-js@^2.0.0": "2.0.10",
		"undici@^6.0.0": "6.29.1",
		"undici@^7.0.0": "7.30.1",
		"uuid@^11.0.0": "11.1.1",
		"uuid@^13.0.0": "13.0.2",
		"uuid@^14.0.0": "14.0.3",
		"valibot": "1.5.0",
		"ws@^7.0.0": "7.5.13",
		"ws@^8.0.0": "8.22.0",
		"storybook": "10.6.2",
		"vite": "7.3.7",
		"zod@^4.0.0": "4.6.7",
		"@ai-sdk/provider-utils-v5@npm:@ai-sdk/provider-utils@3.0.25": "npm:@ai-sdk/provider-utils@3.0.42",
		"@ai-sdk/provider-utils-v6@npm:@ai-sdk/provider-utils@4.0.27": "npm:@ai-sdk/provider-utils@4.0.63",
		"webdriver": "9.32.0",
		"@wdio/config": "9.32.0",
		"@wdio/utils": "9.32.0",
		"miniflare": "4.20260730.0",
		"sharp@^0.35.0": "0.35.5",
		"@opentelemetry/core": "2.12.0",
		"@mastra/core": "1.38.0",
		"@browserbasehq/stagehand": "3.7.3",
		"extract-zip": "npm:@electron-internal/extract-zip@1.0.8",
		"@ai-sdk/provider-utils@^3>undici": "6.29.1",
		"@ai-sdk/provider-utils-v5>undici": "6.29.1",
		"get-uri>basic-ftp": "6.2.3",
		"query-string>decode-uri-component": "0.5.1",
		"react-mosaic-component>uuid": "11.1.1",
		"xcode>uuid": "11.1.1"
	},
	"trustedDependencies": [
		"better-sqlite3",
		"bufferutil",
		"electron",
		"esbuild",
		"koffi",
		"node-pty",
		"sharp",
		"utf-8-validate",
		"workerd"
	],
	"engines": {
		"node": ">=22.13.0"
	},
	"patchedDependencies": {
		"deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
		"query-string@7.1.3": "patches/query-string@7.1.3.patch",
		"image-size@1.2.1": "patches/image-size@1.2.1.patch",
		"katex@0.16.47": "patches/katex@0.16.47.patch",
